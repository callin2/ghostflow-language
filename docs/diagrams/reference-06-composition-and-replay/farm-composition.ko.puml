@startuml
skinparam defaultFontName "Apple SD Gothic Neo"
skinparam shadowing false
skinparam defaultFontSize 13
skinparam rectangleBorderColor #4A6FA5
skinparam rectangleBackgroundColor #F7F9FC
left to right direction
title control Farm의 조합과 binding 계층 (§6.2–§6.4)

rectangle "irrigation.ghost.md\nrevision rev-42 + sha256" as DEF
rectangle "control Farm" as FARM {
  rectangle "root input\neast_start" as ES
  rectangle "instance east:\nIrrigation" as E
  rectangle "root output\neast_pump" as EP
}
rectangle "설치 binding\n(제어 소스가 아님)" as BIND
rectangle "물리 endpoint\n예: board.RO3" as PHY

DEF ..> E : import가 정확한\nrevision을 고정
ES --> E : connect east.start
E --> EP : connect east_pump
EP --> BIND : 논리 포트
BIND --> PHY : binding revision
@enduml

@startuml
skinparam shadowing false
skinparam defaultFontSize 13
skinparam rectangleBorderColor #4A6FA5
skinparam rectangleBackgroundColor #F7F9FC
left to right direction
title Capas de composición y vinculación del control Farm (§6.2–§6.4)

rectangle "irrigation.ghost.md\nrevision rev-42 + sha256" as DEF
rectangle "control Farm" as FARM {
  rectangle "input raíz\neast_start" as ES
  rectangle "instance east:\nIrrigation" as E
  rectangle "output raíz\neast_pump" as EP
}
rectangle "Vinculación de la instalación\n(no es fuente de control)" as BIND
rectangle "Extremo físico\np. ej., board.RO3" as PHY

DEF ..> E : import fija la\nrevisión exacta
ES --> E : connect east.start
E --> EP : connect east_pump
EP --> BIND : puerto lógico
BIND --> PHY : revisión de vinculación
@enduml

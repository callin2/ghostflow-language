@startuml
skinparam shadowing false
skinparam defaultFontSize 13
skinparam rectangleBorderColor #4A6FA5
skinparam rectangleBackgroundColor #F7F9FC
left to right direction
title Branching a ghost timeline from a recorded occurrence (§6.8)

rectangle "Original timeline (preserved)" as O {
  rectangle "tick 1" as O1
  rectangle "tick 2" as O2
  rectangle "tick 3" as O3
}
rectangle "Ghost branch (no physical effect sink)" as G {
  rectangle "tick 2'\n(changed rule or\nvirtual what-if input)" as G2
  rectangle "tick 3'" as G3
}
O1 --> O2
O2 --> O3
O1 --> G2 : branch at\nthis occurrence
G2 --> G3
O2 .. G2 : compare at the\nsame logical tick
O3 .. G3 : compare
@enduml

@startuml
skinparam defaultFontName "PingFang SC"
skinparam shadowing false
skinparam defaultFontSize 13
skinparam rectangleBorderColor #4A6FA5
skinparam rectangleBackgroundColor #F7F9FC
left to right direction
title 从已记录的触发实例分出 ghost 时间线（§6.8）

rectangle "原始时间线（保留）" as O {
  rectangle "tick 1" as O1
  rectangle "tick 2" as O2
  rectangle "tick 3" as O3
}
rectangle "Ghost 分支（无物理效果出口）" as G {
  rectangle "tick 2'\n（修改后的规则或\n虚拟 what-if 输入）" as G2
  rectangle "tick 3'" as G3
}
O1 --> O2
O2 --> O3
O1 --> G2 : 在此触发实例\n处分支
G2 --> G3
O2 .. G2 : 在同一逻辑\ntick 比较
O3 .. G3 : 比较
@enduml

@startuml
skinparam shadowing false
skinparam defaultFontSize 13
skinparam rectangle {
  BackgroundColor #F8F8F8
}
rectangle "GFB1 magic, format version 4" as H
rectangle "Existing sections, up to and\nincluding the scalar state table" as S
rectangle "Temporal context\nu16 nowInput, u16 timeEpochInput" as C
rectangle "Root table\nu16 rootCount; per root: u32 tag, name,\n4 x u16 inputs (present, epoch, id, timestamp)" as R
rectangle "Per strategy" as ST {
  rectangle "name, priority, query (unchanged)" as N
  rectangle "u16 windowCount + window descriptors\n(site, name, operation, payloadType,\noverMs, maxAgeMs, root refs, 6 blobs)" as W
  rectangle "transitions and intents\n(may read slots via opcode 57)" as T
}
H -down-> S
S -down-> C
C -down-> R
R -down-> ST
N -down-> W
W -down-> T
@enduml

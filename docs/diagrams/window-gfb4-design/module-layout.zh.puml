@startuml
skinparam shadowing false
skinparam defaultFontSize 13
skinparam rectangle {
  BackgroundColor #F8F8F8
}
rectangle "GFB1 魔数，格式版本 4" as H
rectangle "现有各节，直到并包括\n标量状态表" as S
rectangle "时间上下文\nu16 nowInput, u16 timeEpochInput" as C
rectangle "根表\nu16 rootCount；每个根：u32 tag、名称、\n4 x u16 输入（present、epoch、id、timestamp）" as R
rectangle "每个策略" as ST {
  rectangle "名称、优先级、查询（不变）" as N
  rectangle "u16 windowCount + 窗口描述符\n（site、name、operation、payloadType、\noverMs、maxAgeMs、根引用、6 个 blob）" as W
  rectangle "转移与意图\n（可通过操作码 57 读取槽位）" as T
}
H -down-> S
S -down-> C
C -down-> R
R -down-> ST
N -down-> W
W -down-> T
@enduml

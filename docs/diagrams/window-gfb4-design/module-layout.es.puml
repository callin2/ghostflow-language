@startuml
skinparam shadowing false
skinparam defaultFontSize 13
skinparam rectangle {
  BackgroundColor #F8F8F8
}
rectangle "Magic GFB1, versión de formato 4" as H
rectangle "Secciones existentes, hasta e\nincluida la tabla de estado escalar" as S
rectangle "Contexto temporal\nu16 nowInput, u16 timeEpochInput" as C
rectangle "Tabla de raíces\nu16 rootCount; por raíz: u32 tag, nombre,\n4 x u16 entradas (present, epoch, id, timestamp)" as R
rectangle "Por estrategia" as ST {
  rectangle "nombre, prioridad, consulta (sin cambios)" as N
  rectangle "u16 windowCount + descriptores de ventana\n(site, name, operation, payloadType,\noverMs, maxAgeMs, refs. a raíces, 6 blobs)" as W
  rectangle "transiciones e intenciones\n(pueden leer slots con el opcode 57)" as T
}
H -down-> S
S -down-> C
C -down-> R
R -down-> ST
N -down-> W
W -down-> T
@enduml

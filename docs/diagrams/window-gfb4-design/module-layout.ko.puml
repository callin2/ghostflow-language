@startuml
skinparam shadowing false
skinparam defaultFontSize 13
skinparam rectangle {
  BackgroundColor #F8F8F8
}
rectangle "GFB1 magic, format version 4" as H
rectangle "기존 section들\n(scalar state 표까지 포함)" as S
rectangle "Temporal context\nu16 nowInput, u16 timeEpochInput" as C
rectangle "Root 표\nu16 rootCount; root마다: u32 tag, 이름,\nu16 입력 4개 (present, epoch, id, timestamp)" as R
rectangle "Strategy마다" as ST {
  rectangle "이름, priority, query (변경 없음)" as N
  rectangle "u16 windowCount + window descriptor\n(site, name, operation, payloadType,\noverMs, maxAgeMs, root 참조, blob 6개)" as W
  rectangle "transition과 intent\n(opcode 57로 slot을 읽을 수 있음)" as T
}
H -down-> S
S -down-> C
C -down-> R
R -down-> ST
N -down-> W
W -down-> T
@enduml

@startuml
skinparam shadowing false
skinparam defaultFontName "PingFang SC"

concise "on_delay_request" as R1
binary "on_delayed" as O1
concise "off_delay_request" as R2
binary "off_delayed" as O2
concise "limited_request" as R3
binary "limited_run" as O3

@0
R1 is true
O1 is low
R2 is true
O2 is high
R3 is true
O3 is high

@2
O1 is high

@4
R2 is false

@7
O2 is low

@10
O3 is low

@12
R1 is false
O1 is low
R3 is false

@enduml

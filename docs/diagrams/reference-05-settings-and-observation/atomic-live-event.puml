@startuml
skinparam shadowing false
skinparam defaultFontSize 13
skinparam activityBorderColor #4A6FA5
skinparam activityBackgroundColor #F7F9FC
title Atomic live settings event (§5.2)

start
:Settings event arrives\n(target Program, baseline revision,\ntarget set, payloads);
if (Envelope intact, same Program, current baseline,\ntargets known, nonempty, no duplicates,\nproducer authorized?) then (yes)
  if (Group mixes different\nexplicit fault codes?) then (yes)
    #FDECEA:Reject as inconsistent packet;
    stop
  elseif (Any payload fails type, range,\nstep or list-capacity check?) then (yes)
    :Emit fault(SettingsInvalid)\nto every target;
  elseif (Producer explicitly unavailable?) then (yes)
    :Emit fault(SettingsUnavailable)\nto every target;
  else (no)
    :Emit ok(value)\nto every target;
  endif
  :New settings revision + effective position.\nSame source, Program and runId.\nState and timers are not reset;
  stop
else (no)
  #FDECEA:Reject before admission\n(no emission on any stream);
  stop
endif
@enduml

@startuml
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam ArrowColor #526d76
skinparam rectangle {
  BackgroundColor #f1f6f5
  BorderColor #6d858b
}
hide stereotype

rectangle "host-tests\ninjected-fixture" as HS
rectangle "device-status\ngpio-readback\nregister-readback" as HWS
rectangle "physical-observation" as PS
rectangle "compuerta host" as H
rectangle "compuerta hardware" as HW
rectangle "compuerta physical" as P

HS --> H
HWS --> HW
PS --> P
H -[hidden]right- HW
HW -[hidden]right- P
H ..> HW : nunca la completa
HW ..> P : la relectura nunca es\nun pass físico
note bottom of P
  No hay pass agregado.
  Cada compuerta: not_run | pass | fail | unknown.
  La fuente "none" solo admite not_run / unknown.
end note
@enduml

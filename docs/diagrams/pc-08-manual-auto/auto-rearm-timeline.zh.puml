@startuml
skinparam shadowing false
skinparam defaultFontName "PingFang SC"

concise "mode（扫描后）" as M
concise "auto_demand" as D
binary "request_armed（扫描后）" as A
concise "run_phase（扫描后）" as P

@0
M is Off
D is true
A is low
P is Stopped

@1
M is Auto

@3
D is false
A is high

@4
D is true
A is low
P is Running

@6
D is false
A is high
P is Stopped

@enduml

@startuml
skinparam shadowing false
skinparam defaultFontName Helvetica

concise "mode (스캔 후)" as M
concise "auto_demand" as D
binary "request_armed (스캔 후)" as A
concise "run_phase (스캔 후)" as P

@0
M is Off
D is true
A is low
P is Stopped

@1
M is Auto

@3
D is false
A is high

@4
D is true
A is low
P is Running

@6
D is false
A is high
P is Stopped

@enduml

@startuml
skinparam shadowing false
skinparam defaultFontName Helvetica
title Inhibition neither resets nor extends the 2 s duration

binary "run_request" as R
binary "permit" as P
binary "drive" as D

@0
R is low
P is high
D is low

@1
R is high
D is high

@2
P is low
D is low

@2.5
P is high
D is high

@3
D is low

@3.5
P is low

@4
P is high

D@1 <-> @3 : 2 s from first accepted true scan
@enduml

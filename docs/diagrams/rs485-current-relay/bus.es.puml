@startuml
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam rectangle {
  BackgroundColor White
  BorderColor #555555
}
left to right direction
title Una conexión RS485, tres dispositivos (9600 8N1)

rectangle "placa ess3h32\nconexión RS485" as board
rectangle "meter1\njsy-mk-333\ndirección 1 (predeterminada del perfil)" as m1
rectangle "meter2\njsy-mk-333\ndirección 2" as m2
rectangle "relay\nryr408b\ndirección 3, RO1..RO8" as rl

board -- m1
board -- m2
board -- rl
m1 ..> board : motor1Current
m2 ..> board : motor2Current
board ..> rl : motor1Run, motor2Run,\nauxiliary3..8
@enduml

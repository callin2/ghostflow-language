@startuml
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam rectangle {
  BackgroundColor White
  BorderColor #555555
}
left to right direction
title 一条 RS485 连接，三台设备（9600 8N1）

rectangle "ess3h32 板\nRS485 连接" as board
rectangle "meter1\njsy-mk-333\n地址 1（profile 默认）" as m1
rectangle "meter2\njsy-mk-333\n地址 2" as m2
rectangle "relay\nryr408b\n地址 3，RO1..RO8" as rl

board -- m1
board -- m2
board -- rl
m1 ..> board : motor1Current
m2 ..> board : motor2Current
board ..> rl : motor1Run, motor2Run,\nauxiliary3..8
@enduml

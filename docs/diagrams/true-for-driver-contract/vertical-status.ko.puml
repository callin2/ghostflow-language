@startuml
skinparam shadowing false
skinparam defaultFontSize 12
skinparam rectangle {
  RoundCorner 8
}
left to right direction
legend top left
  초록 = 구현된 slice
  주황 = 미결 (공개 경로는 RED 유지)
endlegend

rectangle "공개 .ghost.md 컴파일러\n(미지원 진단 활성)" as PC #FFE0B2
rectangle "타입 검사기 + true-for\ndescriptor (직접 Bool)" as TC #C8E6C9
rectangle "GFB format 6\nprelude tag 2, opcode 59" as GFB #C8E6C9
rectangle "ControlRuntime: manifest,\ninterval capture, frame" as CR #FFE0B2
rectangle "WASM activateTemporal\n(GFTA v2)" as W #C8E6C9
rectangle "Native TrueForActivation\n+ Rust tick" as N #C8E6C9
rectangle "TrueFor engine\nstage / commit / rollback" as E #C8E6C9
rectangle "인증된 checkpoint,\nrewind, replay" as CK #FFE0B2

PC --> TC
TC --> GFB
GFB --> N
CR --> W
W --> N
N --> E
E --> CK
@enduml

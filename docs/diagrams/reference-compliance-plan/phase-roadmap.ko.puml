@startuml
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam rectangleRoundCorner 8
rectangle "Phase 0\n진행 작업 통합과 rebaseline" as P0
rectangle "Phase 1\nScalar semantics와\nGFB 실행 기반" as P1
rectangle "Phase 2\nBounded signal\nvertical slice" as P2
rectangle "Phase 3\nSchedule과 accounting" as P3
rectangle "Phase 4\nConstraint, resource와\ncontinuous control" as P4
rectangle "Phase 5\nImport, composition\n및 macro" as P5
rectangle "Phase 6\nSettings, observation,\nreplay, hot replacement" as P6
rectangle "Phase 7\n외부 경계 audit\n(23건)" as P7
rectangle "Phase 8\n최종 acceptance" as P8
P0 --> P1
P1 --> P2 : Duration/Result type
P1 ..> P3
P1 ..> P4
P1 ..> P5
P3 ..> P4 : accounting
P1 --> P6
P2 --> P6
P3 --> P6
P4 --> P6
P5 --> P6 : 안정된 descriptor
P6 --> P7 : 안정된 manifest와\nobservation schema
P7 --> P8
note right of P3 : Date/Time, settings event,\nledger도 필요
note right of P4 : settings도 필요
note right of P5 : 안정된 type/manifest/\nsource identity 필요
@enduml

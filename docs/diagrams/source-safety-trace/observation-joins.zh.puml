@startuml
skinparam shadowing false
skinparam defaultFontSize 13
skinparam rectangleRoundCorner 8
rectangle "编译器伴随数据\ntraceMetadata (source-trace-v1):\nfingerprint, bindings, constraints,\ndependencies, windowSites" as meta
rectangle "运行时追踪\nTickRecord.to_json():\nsafetyTrace, windowTrace" as trace
rectangle "observeSourceTrace\n（源码 + 安全 + 窗口证据）" as ost
rectangle "observeRuntimeValues\n(runtime-values-v1)" as orv
rectangle "interaction-runtime-snapshot\n(runtime-snapshot-v0)" as snap
meta --> ost
trace --> ost
meta --> orv
trace --> orv
orv --> snap : 生成的定时器存储\n在内部解析
note bottom of ost : 只关联实际字段；\n绝不重新求值表达式
@enduml

@startuml
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam ArrowColor #526d76
hide circle
hide methods

entity "requirements" as R {
  id : "GF-REQ-" + first 16 hex of SHA-256(statement)
  statement
  source : path, heading, lines, sha256
  testIds
  status / pendingReason
}
entity "tests" as T {
  id
  locator : path, anchor, lines, sha256
}
R }o--o{ T : testIds
note bottom of R
  no testIds => non-empty
  pendingReason required
end note
@enduml

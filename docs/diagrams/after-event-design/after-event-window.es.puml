@startuml
skinparam shadowing false
skinparam defaultFontSize 13
concise "muestra del predicado" as P
concise "Evento A: ventana [0s, 10s)" as A
concise "Evento B: ventana [4s, 14s)" as B

@0
P is false
A is Pending
B is {-}
@2
P is true
A is Satisfied
@3
P is false
@4
B is Pending
@14
B is Expired
@enduml

@startuml
skinparam shadowing false
skinparam defaultFontName "Hiragino Sans"
skinparam defaultFontSize 13
skinparam rectangle {
  BackgroundColor #F8F8F8
  BorderColor #555555
}

rectangle "ホスト（ブラウザまたは Node）\n永続化・物理停止・フェイルセーフを担当" as Host
rectangle "station.mjs / policy.mjs\n共有ポンプの境界、制約テンプレート" as Station
rectangle "control-runtime.mjs\n仮想出力、センサエンジン、\n入力型の検証、トレース内の品質" as Control
rectangle "ghostflow-runtime.mjs\n生 ABI の依存なしラッパー" as Wrapper
rectangle "ghostflow-wasm cdylib（C ABI）\nESP-IDF と同じ ghostflow-core" as Wasm
rectangle ".gfb + 信頼済み .manifest.json" as Artifact

Host --> Station
Host --> Control
Control --> Wrapper
Wrapper --> Wasm : gf_alloc、.gfb をコピー、\nエクスポートを呼び出し
Artifact --> Control
@enduml

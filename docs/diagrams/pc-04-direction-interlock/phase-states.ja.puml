@startuml
hide empty description
skinparam shadowing false
skinparam defaultFontSize 13
skinparam state {
  BackgroundColor #F8F8F8
  BorderColor #555555
}

state "Stopped\n両方 OFF" as Stopped
state "Forward\nforward ON" as Forward
state "Reverse\nreverse ON" as Reverse
state "WaitReverse\n両方 OFF" as WaitReverse
state "WaitForward\n両方 OFF" as WaitForward

note "どのフェーズからでも:\n!permit または両ボタン\n→ Stopped" as N1

[*] --> Stopped
Stopped --> Forward : forward_event
Stopped --> Reverse : reverse_event
Forward --> WaitReverse : reverse_event
Reverse --> WaitForward : forward_event
WaitReverse --> Reverse : age >= 2s
WaitForward --> Forward : age >= 2s
WaitReverse --> WaitForward : forward_event\n(タイマー再始動)
WaitForward --> WaitReverse : reverse_event\n(タイマー再始動)
@enduml

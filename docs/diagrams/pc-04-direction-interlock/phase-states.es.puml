@startuml
hide empty description
skinparam shadowing false
skinparam defaultFontSize 13
skinparam state {
  BackgroundColor #F8F8F8
  BorderColor #555555
}

state "Stopped\nambas OFF" as Stopped
state "Forward\nforward ON" as Forward
state "Reverse\nreverse ON" as Reverse
state "WaitReverse\nambas OFF" as WaitReverse
state "WaitForward\nambas OFF" as WaitForward

note "Desde cualquier fase:\n!permit o ambos botones\n→ Stopped" as N1

[*] --> Stopped
Stopped --> Forward : forward_event
Stopped --> Reverse : reverse_event
Forward --> WaitReverse : reverse_event
Reverse --> WaitForward : forward_event
WaitReverse --> Reverse : age >= 2s
WaitForward --> Forward : age >= 2s
WaitReverse --> WaitForward : forward_event\n(el temporizador se reinicia)
WaitForward --> WaitReverse : reverse_event\n(el temporizador se reinicia)
@enduml

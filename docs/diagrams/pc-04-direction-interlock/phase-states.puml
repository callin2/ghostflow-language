@startuml
hide empty description
skinparam shadowing false
skinparam defaultFontSize 13
skinparam state {
  BackgroundColor #F8F8F8
  BorderColor #555555
}

state "Stopped\nboth OFF" as Stopped
state "Forward\nforward ON" as Forward
state "Reverse\nreverse ON" as Reverse
state "WaitReverse\nboth OFF" as WaitReverse
state "WaitForward\nboth OFF" as WaitForward

note "From any phase:\n!permit or both buttons\n→ Stopped" as N1

[*] --> Stopped
Stopped --> Forward : forward_event
Stopped --> Reverse : reverse_event
Forward --> WaitReverse : reverse_event
Reverse --> WaitForward : forward_event
WaitReverse --> Reverse : age >= 2s
WaitForward --> Forward : age >= 2s
WaitReverse --> WaitForward : forward_event\n(timer restarts)
WaitForward --> WaitReverse : reverse_event\n(timer restarts)
@enduml

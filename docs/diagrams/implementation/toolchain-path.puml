@startuml
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
left to right direction

file "program.ghost.md" as SRC
rectangle "tools/browser-toolchain.mjs\ncompileSource()" as BT
rectangle "tools/toolchain.mjs\n(Node + file I/O)" as NT
rectangle "tools/literate.mjs\n(CommonMark extraction)" as LIT
rectangle "tools/gfb1.mjs\n(lowering)" as GFB
artifact ".gfb + manifest\n+ .gfb.map.json" as ART
rectangle "runtimes/wasm\n(reference host adapters)" as WASM
rectangle "crates/ghostflow-core\n(VM, state, safety)" as CORE

SRC --> BT
NT --> BT : wraps
BT --> LIT
LIT --> GFB
GFB --> ART
ART --> WASM
WASM --> CORE : exposes
@enduml

@startuml
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
left to right direction

file "program.ghost.md" as SRC
rectangle "tools/browser-toolchain.mjs\ncompileSource()" as BT
rectangle "tools/toolchain.mjs\n(Node + E/S de archivos)" as NT
rectangle "tools/literate.mjs\n(extracción CommonMark)" as LIT
rectangle "tools/gfb1.mjs\n(reducción)" as GFB
artifact ".gfb + manifiesto\n+ .gfb.map.json" as ART
rectangle "runtimes/wasm\n(adaptadores de host de referencia)" as WASM
rectangle "crates/ghostflow-core\n(VM, estado, seguridad)" as CORE

SRC --> BT
NT --> BT : envuelve
BT --> LIT
LIT --> GFB
GFB --> ART
ART --> WASM
WASM --> CORE : expone
@enduml

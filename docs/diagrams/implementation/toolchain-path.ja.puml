@startuml
skinparam shadowing false
skinparam defaultFontName "Hiragino Sans"
skinparam defaultFontSize 13
left to right direction

file "program.ghost.md" as SRC
rectangle "tools/browser-toolchain.mjs\ncompileSource()" as BT
rectangle "tools/toolchain.mjs\n（Node + ファイル I/O）" as NT
rectangle "tools/literate.mjs\n（CommonMark の抽出）" as LIT
rectangle "tools/gfb1.mjs\n（lowering）" as GFB
artifact ".gfb + マニフェスト\n+ .gfb.map.json" as ART
rectangle "runtimes/wasm\n（参照ホストアダプタ）" as WASM
rectangle "crates/ghostflow-core\n（VM、状態、安全）" as CORE

SRC --> BT
NT --> BT : ラップ
BT --> LIT
LIT --> GFB
GFB --> ART
ART --> WASM
WASM --> CORE : 公開
@enduml

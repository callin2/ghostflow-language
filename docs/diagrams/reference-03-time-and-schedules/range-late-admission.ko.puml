@startuml
' Daily 08:00 range(10min); 08:04에 처음 관측; 08:07에 live 설정으로 Duration을 12min으로 변경
skinparam defaultFontSize 12
scale 1 as 70 pixels
concise "벽시계 시각" as W
concise "계획 종료점" as P
concise "Range .active" as A
concise ".due" as D
hide time-axis

@0
W is "07:58"
P is "-"
A is "false"
D is "false"

@2
W is "08:00"
P is "08:10"

@6
W is "08:04"
A is "true"
D is "true"

@7
W is "08:05"
D is "false"

@9
W is "08:07"
P is "08:12"

@14
W is "08:12"
P is "종료"
A is "false"
@enduml

@startuml
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
scale 1 as 50 pixels
hide time-axis

concise "Wall time" as T
concise "Pulse" as P
concise "Window(5min)" as W
concise "Run(5min, on_time)" as O
concise "Run(5min, within(10min))" as R

@0
T is "07:58"
P is "-"
W is "-"
O is "-"
R is "-"

@2
T is "08:00"
P is "admit at crossing"
W is "may admit"
O is "admit at crossing"
R is "may admit"

@3
P is "else missed"
O is "else missed"

@7
T is "08:05"
W is "closed"

@12
T is "08:10"
R is "LateStartExpired"

@14
T is "08:12"

W@2 <-> @7 : [08:00, 08:05)
R@2 <-> @12 : [08:00, 08:10) admission grace, not run length
@enduml

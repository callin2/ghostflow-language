@startuml
skinparam shadowing false
skinparam defaultFontSize 13
skinparam activityBorderColor #4A6FA5
skinparam activityBackgroundColor #F7F9FC
title Input-quality pattern for one Bool input x (per tick)

start
:read input observed_x\n(Result: ok or fault);
if (sample is ok(value)?) then (yes)
  :x_good = true\nx = value;
else (fault)
  :x_good = false\nx = remembered_x\n(last value; initial false is not a sample);
endif
:remembered_x' = x;
if (healthy STOP or healthy\nloss of permission?) then (yes)
  :turn operation off;
elseif (bounded run expired?) then (yes)
  :end the run;
elseif (all needed inputs _good?) then (yes)
  :compute new transition;
else (no)
  :keep previous state\n(no new transition);
endif
stop
@enduml

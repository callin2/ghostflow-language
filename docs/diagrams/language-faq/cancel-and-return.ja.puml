@startuml
skinparam shadowing false
skinparam defaultFontName "Hiragino Sans"
skinparam defaultFontSize 13
skinparam stateBorderColor #4A6FA5
skinparam stateBackgroundColor #F7F9FC
title CancelAndReturn（質問 19）

[*] --> Idle
Idle --> Working : start_event && !cancel
Working --> Stopping : cancel
Stopping --> Idle : stopped && home
Stopping --> Returning : stopped && !home
Returning --> Idle : home

Working : work = true
Stopping : コマンドなし\n（停止フィードバックを待つ）
Returning : return_device = true
note "いずれかの入力が不明なら段階を保持する。\nタイムアウトなし：フィードバックがなければ段階を保持する。" as N
@enduml

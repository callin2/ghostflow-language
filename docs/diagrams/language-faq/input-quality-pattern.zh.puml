@startuml
skinparam shadowing false
skinparam defaultFontSize 13
skinparam activityBorderColor #4A6FA5
skinparam activityBackgroundColor #F7F9FC
title 单个 Bool 输入 x 的输入质量模式（每个 tick）

start
:读取输入 observed_x\n（Result：ok 或 fault）;
if (样本是 ok(value)？) then (是)
  :x_good = true\nx = value;
else (fault)
  :x_good = false\nx = remembered_x\n（最后的值；初始 false 不是样本）;
endif
:remembered_x' = x;
if (健康的 STOP 或\n健康的许可丧失？) then (是)
  :关闭运行;
elseif (有界运行已到期？) then (是)
  :结束本次运行;
elseif (所需输入全部 _good？) then (是)
  :计算新的转换;
else (否)
  :保持之前的状态\n（无新的转换）;
endif
stop
@enduml

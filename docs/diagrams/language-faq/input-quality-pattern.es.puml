@startuml
skinparam shadowing false
skinparam defaultFontSize 13
skinparam activityBorderColor #4A6FA5
skinparam activityBackgroundColor #F7F9FC
title Patrón de calidad de entrada para una entrada Bool x (por tick)

start
:leer la entrada observed_x\n(Result: ok o fault);
if (¿la muestra es ok(value)?) then (sí)
  :x_good = true\nx = value;
else (fault)
  :x_good = false\nx = remembered_x\n(último valor; el false inicial no es una muestra);
endif
:remembered_x' = x;
if (¿STOP sano o pérdida\nsana del permiso?) then (sí)
  :apagar la operación;
elseif (¿venció la ejecución acotada?) then (sí)
  :terminar la ejecución;
elseif (¿todas las entradas necesarias _good?) then (sí)
  :calcular la nueva transición;
else (no)
  :conservar el estado anterior\n(sin nueva transición);
endif
stop
@enduml

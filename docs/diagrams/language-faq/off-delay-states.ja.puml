@startuml
skinparam shadowing false
skinparam defaultFontName "Hiragino Sans"
skinparam defaultFontSize 13
skinparam stateBorderColor #4A6FA5
skinparam stateBackgroundColor #F7F9FC
title OffDelay（質問 6）：enabled は Active と Holding で true

[*] --> Idle
Idle --> Active : request && !stop
Active --> Holding : !request
Active --> Idle : stop
Holding --> Active : request
Holding --> Idle : stop || age >= delay
note "Holding は入力が不明でも期限切れになる。\n健全な stop または無効な delay：どの段階からも Idle へ。" as N
@enduml

@startuml
skinparam shadowing false
skinparam defaultFontSize 12
left to right direction
rectangle "Perfil del dispositivo" as prof
rectangle "basic\npriority 0\n(pump, valve, low_water)" as basic
rectangle "moisture_aware\npriority 10\n(+ moisture)" as aware
rectangle "blocked =\nstop or low_water\n(Err -> true)" as blocked
rectangle "dry = moisture < 35\n(Err -> false)" as dry
rectangle "next.watering =\nlatch(start, blocked,\nstate.watering)" as latch
rectangle "intent\nvalve, pump" as intent
rectangle "safety\npump requires valve" as safety
prof --> basic : sin moisture
prof --> aware : con moisture\n(gana la mayor prioridad)
basic --> blocked
aware --> blocked
aware --> dry
blocked --> latch
dry --> latch : and (solo moisture_aware)
latch --> intent
intent --> safety
@enduml

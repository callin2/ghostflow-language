@startuml
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam ArrowColor #526d76
skinparam rectangle {
  BackgroundColor #f1f6f5
  BorderColor #6d858b
}
hide stereotype

rectangle "정본 .ghost.md\n(유일한 제어 소스)" as Src
rectangle "컴파일러\n(#71)" as Comp
rectangle "Interaction 스키마\n(정적 descriptor)" as Schema
rectangle "완료된 native/WASM\n추적 (스캔 하나)" as Trace
rectangle "스냅샷 생성자\n(#72, 스키마 검증)" as Prod
rectangle "런타임 스냅샷\nschema.sha256, module,\nsource, runId, scanId" as Snap
rectangle "소비자 결합\n(검증기 + 예상 식별자)" as Join
rectangle "valid" as Ok
rectangle "join.status: stale\n(식별자가 예상과\n다름)" as Stale
rectangle "검증 오류\n(문서끼리 불일치)" as Err

Src --> Comp
Comp --> Schema
Comp --> Trace : 모듈이\n호스트에서 실행
Schema --> Prod
Trace --> Prod : 읽기 전용 투영
Prod --> Snap : descriptor마다\n관찰 하나
Schema --> Join
Snap --> Join
Join --> Ok
Join --> Stale
Join --> Err
@enduml

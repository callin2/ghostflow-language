@startuml
skinparam shadowing false
skinparam defaultFontSize 13
skinparam ActivityBackgroundColor #F7F9FC
skinparam ActivityBorderColor #4A6FA5
title E04: both next states read the same previous state

start
:Previous state\na = true, b = false;
fork
  :a' = b\n-> false;
fork again
  :b' = a\n-> true;
end fork
:Commit both together\na = false, b = true;
:Next tick reads\na = false, b = true;
fork
  :a' = b\n-> true;
fork again
  :b' = a\n-> false;
end fork
:Commit both together\na = true, b = false;
stop
@enduml

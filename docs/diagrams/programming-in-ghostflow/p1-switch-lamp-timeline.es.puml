@startuml
skinparam shadowing false
skinparam defaultFontName Helvetica
title Escenario de transición de E01: soltar, pulsar, soltar, fallo, pulsar (un paso = un tick)

concise "switch_on" as S
binary "lamp" as L
scale 1 as 120 pixels

@1
S is "ok(false)"
L is low

@2
S is "ok(true)"
L is high

@3
S is "ok(false)"
L is low

@4
S is "fault(Stale)"
L is low

@5
S is "ok(true)"
L is high

@6
@enduml

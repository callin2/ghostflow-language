@startuml
skinparam shadowing false
skinparam defaultFontName Helvetica

start
:Host supplies a fresh sample\n(original timestamp, identity);
if (Healthy, within valid = 0%..100%,\nage < stale_after = 3s?) then (yes)
  :median(3) of last three\nfresh valid samples;
  if (Window has three values?) then (yes)
    :hysteresis\non_below 30%, off_above 35%;
    :dry = ok(value);
  else (no)
    :dry = fault(NotReady);
  endif
else (no)
  :Clear filter window;\nreset hysteresis to initial: false;
  :dry = fault(...);
endif
:need_water = case dry\nok(value) => value\nfault(_) => false;
:pump request = enabled && need_water\n(keeps last request while enabled is faulted);
stop
@enduml

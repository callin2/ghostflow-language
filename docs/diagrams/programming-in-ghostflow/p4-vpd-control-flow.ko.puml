@startuml
skinparam shadowing false
skinparam defaultFontName "Apple SD Gothic Neo"
skinparam defaultFontSize 13
skinparam componentStyle rectangle
title E19–E21: 빛 조건이 걸린 공기 VPD 요구

rectangle "air: Temperature" as air
rectangle "humidity: RelativeHumidity" as rh
rectangle "light: PPFD" as light
component "climate = air_vpd(t, rh)\n(입력 하나라도 fault면 fault)" as climate
component "state demand\nON / OFF / 유지 구간에서 유지\n(fault -> false)" as demand
component "daylight = ppfd >= 기준\n(fault -> false)" as day
rectangle "air_vpd_value\n(fault 때 0: 표시용 대체값)" as vpd
rectangle "vpd_valid" as valid
rectangle "*_demand = daylight && demand'" as out

air --> climate
rh --> climate
climate --> demand
climate --> vpd
climate --> valid
light --> day
demand --> out
day --> out
@enduml

@startuml
skinparam shadowing false
skinparam defaultFontName "Apple SD Gothic Neo"
skinparam defaultFontSize 13
skinparam componentStyle rectangle
title E22: 샘플 packet 하나, 고정된 instance 두 개

rectangle "root 입력\nair, humidity, light" as in
component "instance high: HighVpd\n(E19.ghost.md, 고정)" as high
component "instance low: LowVpd\n(E20.ghost.md, 고정)" as low
rectangle "air_vpd_value\nvpd_valid" as common
rectangle "humidify_demand" as hd
rectangle "ventilate_demand" as vd

in --> high : connect
in --> low : connect
high --> common
high --> hd
low --> vd
@enduml

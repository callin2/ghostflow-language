@startuml
skinparam shadowing false
skinparam defaultFontSize 13
title E37: minutes after planned time (planned = high tide - 30min; admitted 4 min late)

concise "Admission" as S
concise "pump (output intent)" as P

@0
S is "open: [planned, planned+10min)"
P is "false"

@4
P is "run 5min from admission"

@9
P is "false"

@10
S is "closed (end excluded)"

S@0 <-> @10 : within(10min)
P@4 <-> @9 : run(5min)
@enduml

@startuml
skinparam shadowing false
skinparam defaultFontSize 13
skinparam ActivityBackgroundColor #F7F9FC
skinparam ActivityBorderColor #4A6FA5
title E04: 두 다음 상태는 같은 이전 상태를 읽습니다

start
:이전 상태\na = true, b = false;
fork
  :a' = b\n-> false;
fork again
  :b' = a\n-> true;
end fork
:둘을 함께 확정\na = false, b = true;
:다음 tick이 읽는 값\na = false, b = true;
fork
  :a' = b\n-> true;
fork again
  :b' = a\n-> false;
end fork
:둘을 함께 확정\na = true, b = false;
stop
@enduml

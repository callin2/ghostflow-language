@startuml
skinparam shadowing false
skinparam defaultFontSize 13
skinparam componentStyle rectangle
title E19–E21: air VPD demand gated by light

rectangle "air: Temperature" as air
rectangle "humidity: RelativeHumidity" as rh
rectangle "light: PPFD" as light
component "climate = air_vpd(t, rh)\n(fault if either input faults)" as climate
component "state demand\nON / OFF / keep in dead band\n(fault -> false)" as demand
component "daylight = ppfd >= gate\n(fault -> false)" as day
rectangle "air_vpd_value\n(0 on fault: placeholder)" as vpd
rectangle "vpd_valid" as valid
rectangle "*_demand = daylight && demand'" as out

air --> climate
rh --> climate
climate --> demand
climate --> vpd
climate --> valid
light --> day
demand --> out
day --> out
@enduml

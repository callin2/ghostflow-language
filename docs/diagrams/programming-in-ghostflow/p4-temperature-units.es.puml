@startuml
skinparam shadowing false
skinparam defaultFontSize 13
skinparam componentStyle rectangle
title Un umbral físico, tres unidades de origen

rectangle "E16: 18°C" as c
rectangle "E17: 64.4°F" as f
rectangle "E18: 291.15K" as k
component "Conversión exacta del literal,\nluego redondeo binary64" as conv
rectangle "Temperature canónica\n291.15 K" as canon
component "hysteresis(air, on_below, ...)" as h
rectangle "Misma decisión del calefactor" as out

c --> conv
f --> conv
k --> conv
conv --> canon
canon --> h
h --> out
@enduml

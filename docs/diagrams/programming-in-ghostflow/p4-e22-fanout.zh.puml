@startuml
skinparam shadowing false
skinparam defaultFontName "PingFang SC"
skinparam defaultFontSize 13
skinparam componentStyle rectangle
title E22：一个样本数据包，两个固定的实例

rectangle "root 输入\nair, humidity, light" as in
component "instance high: HighVpd\n(E19.ghost.md，已固定)" as high
component "instance low: LowVpd\n(E20.ghost.md，已固定)" as low
rectangle "air_vpd_value\nvpd_valid" as common
rectangle "humidify_demand" as hd
rectangle "ventilate_demand" as vd

in --> high : connect
in --> low : connect
high --> common
high --> hd
low --> vd
@enduml

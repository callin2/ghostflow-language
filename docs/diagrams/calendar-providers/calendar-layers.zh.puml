@startuml
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam ArrowColor #555555
skinparam rectangle {
  BackgroundColor White
  BorderColor #555555
}
title 日历层次与执行路径

rectangle "已审核数据集\nkr-public-2026-2027.json" as D
rectangle "HolidayCalendar\ncreateKoreanHolidayCalendar" as H
rectangle "WorkCalendar\ncreateWorkCalendar\n（每周掩码、节假日策略）" as W
rectangle "组合日历\ncomposeCalendar\n（新 ID + 修订版）" as O
rectangle "安装绑定\n（日历 ID、时区）" as B
rectangle "每个 tick 的上下文事实\n（时钟、覆盖范围、行、\nenvelope.snapshot）" as F
rectangle "共享 Rust 核心\n（日期过滤、准入、\ngap/recovery、去重）" as R

D --> H
H --> W : 基础
W --> O : 基础 + 覆盖
O --> B
B --> F
F --> R
@enduml

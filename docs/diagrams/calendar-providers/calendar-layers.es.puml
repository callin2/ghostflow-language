@startuml
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam ArrowColor #555555
skinparam rectangle {
  BackgroundColor White
  BorderColor #555555
}
title Capas del calendario y ruta de ejecución

rectangle "Conjunto de datos revisado\nkr-public-2026-2027.json" as D
rectangle "HolidayCalendar\ncreateKoreanHolidayCalendar" as H
rectangle "WorkCalendar\ncreateWorkCalendar\n(máscara semanal, política de festivos)" as W
rectangle "Calendario compuesto\ncomposeCalendar\n(nuevo ID + revisión)" as O
rectangle "Vinculación de la instalación\n(ID de calendario, zona horaria)" as B
rectangle "Hechos de contexto por tick\n(reloj, cobertura, filas,\nenvelope.snapshot)" as F
rectangle "Núcleo compartido de Rust\n(filtro por días, admisión,\nbrecha/recuperación, deduplicación)" as R

D --> H
H --> W : base
W --> O : base + sustituciones
O --> B
B --> F
F --> R
@enduml

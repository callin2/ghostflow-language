@startuml
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam ArrowColor #555555
skinparam rectangle {
  BackgroundColor White
  BorderColor #555555
}
title 달력 계층과 실행 경로

rectangle "검토된 데이터셋\nkr-public-2026-2027.json" as D
rectangle "HolidayCalendar\ncreateKoreanHolidayCalendar" as H
rectangle "WorkCalendar\ncreateWorkCalendar\n(주간 mask, 공휴일 정책)" as W
rectangle "합성 달력\ncomposeCalendar\n(새 ID + revision)" as O
rectangle "설치 바인딩\n(달력 ID, 시간대)" as B
rectangle "tick별 context fact\n(clock, coverage, 행,\nenvelope.snapshot)" as F
rectangle "공유 Rust core\n(날짜 필터, admission,\ngap/recovery, 중복 억제)" as R

D --> H
H --> W : base
W --> O : base + override
O --> B
B --> F
F --> R
@enduml

{
  "name": "ghostflow-language",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node tools/verify-language.mjs",
    "test:node": "node tools/verify-language.mjs --node-only",
    "docs:check": "node tools/check-doc-translations.mjs && npm run docs:index:check",
    "test:compiler": "node --test tests/compiler.test.mjs tests/docs-runnable-examples.test.mjs tests/int-compiler.test.mjs tests/constraints.test.mjs tests/literate.test.mjs tests/toolchain.test.mjs tests/interaction-emission.test.mjs tests/browser-toolchain.test.mjs",
    "test:contract": "node --test tests/integration-contract.test.mjs",
    "test:reference": "node --test tests/reference-cli.test.mjs",
    "test:coverage": "node tools/coverage-language.mjs",
    "test:mutation:output": "node tools/mutation-output-contract.mjs",
    "generate:pc01": "node tools/generate-pc-01-projection.mjs --write",
    "generate:pig-imports": "node tools/generate-programming-book-import-package.mjs --write",
    "tutorial": "node tools/tutorial.mjs",
    "compile": "node tools/ghostc.mjs",
    "compile:example": "node tools/ghostc.mjs examples/scheduled-watering.ghost.md build/scheduled-watering.gfb",
    "constraints": "node tools/ghostrules.mjs",
    "build:wasm": "cargo build --locked --offline -p ghostflow-wasm --target wasm32-unknown-unknown --release",
    "docs:index": "node tools/check-doc-index-provenance.mjs && node tools/doc-index/docs-index.mjs --docs-dir docs && node tools/doc-index/docs-index.mjs --docs-dir .",
    "docs:index:check": "node tools/check-doc-index-provenance.mjs && node tools/doc-index/docs-index.mjs --check --docs-dir docs && node tools/doc-index/docs-index.mjs --check --docs-dir .",
    "docs:find": "node tools/check-doc-index-provenance.mjs && node tools/doc-index/docs-find.mjs",
    "test:portable-package": "node --test tests/requirement-catalog.test.mjs && node --test tests/portable-package.test.mjs"
  },
  "dependencies": {
    "@toon-format/toon": "4.1.1",
    "commonmark": "0.31.2",
    "suncalc": "2.0.2"
  }
}

// HISTORICAL NON-EXECUTABLE EVIDENCE. Canonical source: 01-latch.ghost.md.
// This raw pre-literate source is not a product compiler input or fallback.
control LatchingPump {
  input start: Bool;
  input stop: Bool;

  output pump, valve: Bool;
  state watering: Bool = false;

  // stop wins when start and stop arrive in the same tick.
  watering' = !stop && (start || watering);

  valve <- watering';
  pump  <- watering';
  require pump => valve;
}
